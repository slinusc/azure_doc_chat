# ============================================
# AZURE RAG APPLICATION - Configuration Template
# ============================================
# Copy this file to .env and fill in your Azure credentials
# Never commit your actual .env file with real credentials to version control

# ============================================
# AZURE BLOB STORAGE - Document Storage
# ============================================
# Connection string for Azure Blob Storage (used to store uploaded PDFs)
# Format: DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_STORAGE_ACCOUNT;AccountKey=YOUR_STORAGE_KEY;EndpointSuffix=core.windows.net

# Name of the container in Blob Storage where PDFs are stored
AZURE_STORAGE_CONTAINER_NAME=documents

# ============================================
# AZURE OPENAI - Embeddings Service
# ============================================
# Endpoint for Azure OpenAI embeddings API
# Format: https://<resource-name>.cognitiveservices.azure.com/
AZURE_OPENAI_EMBEDDINGS_ENDPOINT=https://your-embeddings-endpoint.cognitiveservices.azure.com/

# API key for embeddings service
AZURE_OPENAI_EMBEDDINGS_API_KEY=your_embeddings_api_key_here

# Model name for text embeddings (generates 1536-dimensional vectors)
# Available models: text-embedding-3-small, text-embedding-3-large
AZURE_OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# ============================================
# AZURE DOCUMENT INTELLIGENCE - PDF Extraction
# ============================================
# Endpoint for Azure Document Intelligence API (for intelligent PDF text extraction)
# Format: https://<resource-name>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-document-intelligence-endpoint.cognitiveservices.azure.com/

# API key for document intelligence service
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=your_document_intelligence_api_key_here

# ============================================
# AZURE OPENAI - Language Model (Chat)
# ============================================
# Full endpoint URL for Azure OpenAI chat completions
# Includes deployment name and API version in the URL
# Format: https://<resource-name>.<region>.cognitiveservices.azure.com/openai/deployments/<deployment-name>/chat/completions?api-version=<version>
AZURE_OPENAI_LLM_ENDPOINT=https://your-resource-name.region.cognitiveservices.azure.com/openai/deployments/your-deployment-name/chat/completions?api-version=2025-01-01-preview

# API key for the language model
AZURE_OPENAI_LLM_API_KEY=your_llm_api_key_here

# Model name deployed in Azure OpenAI
# Examples: gpt-4, gpt-3.5-turbo, gpt-5-nano
AZURE_OPENAI_LLM_MODEL=gpt-5-nano

# ============================================
# AZURE COGNITIVE SEARCH - Vector Search
# ============================================
# Endpoint for Azure Cognitive Search service
# Format: https://<search-service-name>.search.windows.net
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net

# API key for cognitive search (use "Manage queries" or "Manage all keys" from Azure Portal)
AZURE_SEARCH_API_KEY=your_search_api_key_here

# Name of the search index where document chunks and embeddings are stored
AZURE_SEARCH_INDEX_NAME=rag-index
